{
  "name": "portfolio-forge-rules-tests",
  "private": true,
  "description": "Security-rules tests. Run against the Firebase emulators so rule changes cannot silently open data.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project demo-portfolio-forge \"jest --runInBand\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^13.2.0",
    "firebase-tools": "^14.0.0",
    "jest": "^29.7.0"
  },
  "jest": { "testEnvironment": "node", "testTimeout": 20000 }
}
