rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Portfolio wala rule waisa hi rahega
    match /portfolios/{userId} {
      allow read, write, delete: if request.auth.uid == userId;
    }

    // Feedback wala rule ab Custom Claim check karega
    match /feedback/{feedbackId} {
      // Feedback create koi bhi logged-in user kar sakta hai
      allow create: if request.auth != null;

      // --- YEH HAI ASLI SECURITY ---
      // Feedback read/list sirf woh user kar sakta hai jiske token mein
      // 'admin' ka tag 'true' set ho.
      allow read, list: if request.auth.token.admin == true;
    }
  }
}