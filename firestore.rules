rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // PRIVATE: the editable draft (all versions, hidden fields, address, etc.).
    // Only the owner can ever read or write it.
    match /portfolios/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.data.keys().size() <= 40;
    }

    // PRIVATE: the job-application tracker. One small document per user; the size is also capped
    // by the client (200 entries). Never public.
    match /tracker/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
                   && request.resource.data.keys().hasOnly(['jobs'])
                   && request.resource.data.jobs is list
                   && request.resource.data.jobs.size() <= 200;
    }

    // PUBLIC: sanitized copies written by the owner on "Save & Publish".
    // Anyone may read (that is what makes /p/:uid and /resume/:uid work for
    // logged-out visitors); only the owner may write. Hidden sections, the
    // address and version names/goals are stripped before publishing.
    // Public pages are fetched by exact id (get). Listing is owner-only, so nobody can
    // enumerate every published portfolio or user id.
    match /published/{userId} {
      allow get: if true;
      allow list: if false;
      allow write: if isOwner(userId)
                   && request.resource.data.keys().hasOnly(['activeVersion', 'updatedAt']);

      match /versions/{versionId} {
        allow get: if true;
        allow list: if isOwner(userId);
        allow write: if isOwner(userId) && request.resource.data.keys().size() <= 40;
      }
    }

    // Feedback from signed-in users. Strictly shaped and size-limited; only the maintainer
    // (custom claim admin=true) can read everything. Each user can read and delete their own entries,
    // so export/erasure on the Account page works.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['portfolioContextId', 'submitterId', 'submitterEmail', 'rating', 'comment', 'timestamp'])
                    && request.resource.data.submitterId == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() > 0 && request.resource.data.comment.size() <= 1000
                    && request.resource.data.portfolioContextId is string
                    && request.resource.data.portfolioContextId.size() <= 128
                    && request.resource.data.submitterEmail is string
                    && request.resource.data.submitterEmail.size() <= 320
                    && request.resource.data.timestamp == request.time;
      allow read: if request.auth != null
                  && (request.auth.token.admin == true || resource.data.submitterId == request.auth.uid);
      allow delete: if request.auth != null && resource.data.submitterId == request.auth.uid;
      allow update: if false;
    }

    // AI usage counters are written by the Cloud Function (Admin SDK) only.
    match /aiUsage/{docId} {
      allow read, write: if false;
    }
  }
}
